<section class="fbl-vn-frame-panel" {{#unless selectedScene}}hidden{{/unless}}>
  {{#if selectedScene}}
          {{#if selectedFrame}}
            <div class="fbl-vn-field-row row-frame-title">
              <div class="form-group">
                <label for="fbl-vn-frame-type">Тип</label>
                <select id="fbl-vn-frame-type" name="frame.type">
                  {{#each frameTypeOptions}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if invalid}}class="is-invalid-option"{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </div>
              <div class="form-group">
                <label for="fbl-vn-frame-branch">Ветка</label>
                <select id="fbl-vn-frame-branch" name="frame.branchId">
                  {{#each frameBranchOptions}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </div>
              <div class="form-group">
                <label for="fbl-vn-frame-folder">Папка</label>
                <select id="fbl-vn-frame-folder" name="frame.folderId">
                  {{#each folderOptions}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </div>
              <div class="form-group">
                <label for="fbl-vn-frame-title">Техническое имя кадра</label>
                <input id="fbl-vn-frame-title" type="text" name="frame.title" value="{{selectedFrame.title}}" placeholder="Например: Вход в церковь" />
              </div>
            </div>
  
            <div class="fbl-vn-field-row row-background">
              <div class="form-group path-field">
                <label for="fbl-vn-frame-background">Фон</label>
                <input id="fbl-vn-frame-background" type="text" name="frame.background" value="{{selectedFrame.background}}" placeholder="Путь к изображению. Пусто = оставить предыдущий фон." />
                <button type="button" data-action="pickAsset" data-field="frame.background" data-picker-type="image" title="Выбрать файл" aria-label="Выбрать файл"><i class="fa-solid fa-folder-open"></i></button>
              </div>
              <div class="form-group">
                <label for="fbl-vn-frame-transition">Переход</label>
                <select id="fbl-vn-frame-transition" name="frame.transition">
                  {{#each transitionOptions}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if invalid}}class="is-invalid-option"{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </div>
              <div class="form-group">
                <label for="fbl-vn-frame-vignette">Виньетка</label>
                <select id="fbl-vn-frame-vignette" name="frame.vignetteMode" title="Авто: по краям для обычной панели, вокруг текста для центрального текста">
                  {{#each vignetteOptions}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </div>
              <label class="form-group icon-toggle-field" title="Очистить фон" aria-label="Очистить фон">
                <span class="field-label-spacer" aria-hidden="true"></span>
                <input type="checkbox" name="frame.clearBackground" {{#if selectedFrame.clearBackground}}checked{{/if}} />
                <span class="icon-toggle"><i class="fa-solid fa-eraser"></i></span>
              </label>
            </div>
  
            <section class="fbl-vn-frame-characters">
              <header class="fbl-vn-frame-characters-header">
                <h4>Персонажи в кадре</h4>
                <div class="fbl-vn-frame-characters-actions">
                  <button type="button" data-action="addFrameCharacter"><i class="fa-solid fa-plus"></i> Добавить персонажа</button>
                  <button type="button" data-action="openCharacterManager" title="Редактировать пресеты персонажей" aria-label="Редактировать пресеты персонажей"><i class="fa-solid fa-users-gear"></i></button>
                </div>
              </header>

              <div class="fbl-vn-frame-character-list">
                <article class="fbl-vn-frame-character-card is-primary">
                  <header>
                    <strong>Персонаж 1</strong>
                    <span>Основной</span>
                    <button type="button" class="fbl-vn-row-icon" data-action="saveCharacterPreset" title="Сохранить текущего говорящего и портрет как пресет персонажа" aria-label="Сохранить пресет персонажа"><i class="fa-solid fa-user-plus"></i></button>
                  </header>

                  <div class="fbl-vn-field-row row-character">
                    <div class="form-group">
                      <label for="fbl-vn-frame-character">Пресет персонажа</label>
                      <select id="fbl-vn-frame-character" name="frame.characterId" data-character-select>
                        {{#each characterOptions}}
                          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                      </select>
                    </div>
                    <div class="form-group">
                      <label for="fbl-vn-frame-portrait-preset">Портрет пресета</label>
                      <select id="fbl-vn-frame-portrait-preset" name="frame.portraitId" data-character-portrait-select>
                        {{#each characterPortraitOptions}}
                          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                      </select>
                    </div>
                  </div>

                  <div class="fbl-vn-field-row row-frame-character-visual">
                    <div class="form-group">
                      <label for="fbl-vn-frame-speaker">Имя</label>
                      <input id="fbl-vn-frame-speaker" type="text" name="frame.speaker" value="{{selectedFrame.speaker}}" placeholder="Имя персонажа" />
                    </div>
                    <div class="form-group path-field">
                      <label for="fbl-vn-frame-portrait">Портрет / спрайт</label>
                      <input id="fbl-vn-frame-portrait" type="text" name="frame.portrait" value="{{selectedFrame.portrait}}" placeholder="Путь к изображению. Пусто = оставить предыдущий портрет." />
                      <button type="button" data-action="pickAsset" data-field="frame.portrait" data-picker-type="image" title="Выбрать файл" aria-label="Выбрать файл"><i class="fa-solid fa-folder-open"></i></button>
                    </div>
                    <div class="form-group">
                      <label for="fbl-vn-frame-position">Позиция</label>
                      <select id="fbl-vn-frame-position" name="frame.portraitPosition">
                        {{#each positionOptions}}
                          <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if invalid}}class="is-invalid-option"{{/if}}>{{label}}</option>
                        {{/each}}
                      </select>
                    </div>
                    <label class="form-group icon-toggle-field" title="Показывать имя" aria-label="Показывать имя">
                      <span class="field-label-spacer" aria-hidden="true"></span>
                      <input type="checkbox" name="frame.showSpeakerName" {{#if selectedFrame.showSpeakerName}}checked{{/if}} />
                      <span class="icon-toggle"><i class="fa-solid fa-id-badge"></i></span>
                    </label>
                    <label class="form-group icon-toggle-field" title="Скрыть портрет" aria-label="Скрыть портрет">
                      <span class="field-label-spacer" aria-hidden="true"></span>
                      <input type="checkbox" name="frame.hidePortrait" {{#if selectedFrame.hidePortrait}}checked{{/if}} />
                      <span class="icon-toggle"><i class="fa-solid fa-user-slash"></i></span>
                    </label>
                  </div>
                </article>

                {{#each additionalFrameCharacters}}
                  <article class="fbl-vn-frame-character-card" data-additional-character-row data-frame-character-id="{{id}}">
                    <header>
                      <strong>Персонаж {{index}}</strong>
                      <span>{{#if name}}{{name}}{{else}}Дополнительный{{/if}}</span>
                      <button type="button" class="danger fbl-vn-row-icon" data-action="deleteFrameCharacter" data-frame-character-id="{{id}}" title="Убрать персонажа из кадра" aria-label="Убрать персонажа из кадра"><i class="fa-solid fa-trash"></i></button>
                    </header>

                    <div class="fbl-vn-field-row row-character">
                      <div class="form-group">
                        <label>Пресет персонажа</label>
                        <select data-frame-character-select>
                          {{#each characterOptions}}
                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                          {{/each}}
                        </select>
                      </div>
                      <div class="form-group">
                        <label>Портрет пресета</label>
                        <select data-frame-character-portrait-select>
                          {{#each portraitOptions}}
                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                          {{/each}}
                        </select>
                      </div>
                    </div>

                    <div class="fbl-vn-field-row row-frame-character-visual">
                      <div class="form-group">
                        <label>Имя</label>
                        <input type="text" data-frame-character-name value="{{name}}" placeholder="Имя персонажа" />
                      </div>
                      <div class="form-group path-field">
                        <label>Портрет / спрайт</label>
                        <input type="text" name="{{portraitInputName}}" data-frame-character-portrait value="{{portrait}}" placeholder="Путь к изображению" />
                        <button type="button" data-action="pickAsset" data-field="{{portraitInputName}}" data-picker-type="image" title="Выбрать файл" aria-label="Выбрать файл"><i class="fa-solid fa-folder-open"></i></button>
                      </div>
                      <div class="form-group">
                        <label>Позиция</label>
                        <select data-frame-character-position>
                          {{#each positionOptions}}
                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                          {{/each}}
                        </select>
                      </div>
                      <label class="form-group icon-toggle-field" title="Показывать имя" aria-label="Показывать имя">
                        <span class="field-label-spacer" aria-hidden="true"></span>
                        <input type="checkbox" data-frame-character-show-name {{#if showName}}checked{{/if}} />
                        <span class="icon-toggle"><i class="fa-solid fa-id-badge"></i></span>
                      </label>
                    </div>
                  </article>
                {{/each}}
              </div>
            </section>

            <section class="fbl-vn-text-blocks">
              <header>
                <h4>Текстовые блоки</h4>
                <div class="fbl-vn-text-block-header-actions">
                  <label class="fbl-vn-text-presentation">
                    <span>Показ</span>
                    <select name="frame.textPresentation" title="Как показывать текст в плеере">
                      {{#each textPresentationOptions}}
                        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                      {{/each}}
                    </select>
                  </label>
                  <button type="button" data-action="addTextBlock"><i class="fa-solid fa-plus"></i> Добавить</button>
                </div>
              </header>
              <div class="fbl-vn-text-block-list">
                {{#each selectedTextBlocks}}
                  <div class="fbl-vn-text-block-row" data-text-block-row data-text-block-id="{{id}}">
                    <div class="fbl-vn-rich-text-editor" data-rich-text-editor>
                      <div class="fbl-vn-rich-toolbar" data-rich-toolbar aria-label="Форматирование текста">
                        <button type="button" data-rich-command="bold" title="Жирный" aria-label="Жирный"><i class="fa-solid fa-bold"></i></button>
                        <button type="button" data-rich-command="italic" title="Курсив" aria-label="Курсив"><i class="fa-solid fa-italic"></i></button>
                        <button type="button" data-rich-command="underline" title="Подчёркнутый" aria-label="Подчёркнутый"><i class="fa-solid fa-underline"></i></button>
                        <button type="button" data-rich-command="strikeThrough" title="Зачёркнутый" aria-label="Зачёркнутый"><i class="fa-solid fa-strikethrough"></i></button>
                        <button type="button" data-rich-command="subscript" title="Нижний индекс" aria-label="Нижний индекс">x<sub>2</sub></button>
                        <button type="button" data-rich-command="superscript" title="Верхний индекс" aria-label="Верхний индекс">x<sup>2</sup></button>

                        <span class="fbl-vn-rich-toolbar-separator" aria-hidden="true"></span>

                        <select data-rich-command-select="fontName" title="Шрифт" aria-label="Шрифт">
                          <option value="">Шрифт</option>
                          {{#each ../richTextFontOptions}}
                            <option value="{{value}}">{{label}}</option>
                          {{/each}}
                        </select>

                        <select data-rich-command-select="fontSize" title="Размер текста" aria-label="Размер текста">
                          <option value="">Размер</option>
                          <option value="1">Очень мелкий</option>
                          <option value="2">Мелкий</option>
                          <option value="3">Обычный</option>
                          <option value="4">Крупный</option>
                          <option value="5">Большой</option>
                          <option value="6">Очень большой</option>
                          <option value="7">Огромный</option>
                        </select>

                        <label class="fbl-vn-rich-color" title="Цвет текста">
                          <input type="color" data-rich-color value="#efe8db" aria-label="Цвет текста" />
                        </label>
                        <label class="fbl-vn-rich-color" title="Цвет фона текста">
                          <input type="color" data-rich-highlight value="#5a4528" aria-label="Цвет фона текста" />
                        </label>

                        <span class="fbl-vn-rich-toolbar-separator" aria-hidden="true"></span>

                        <button type="button" data-rich-command="justifyLeft" title="По левому краю" aria-label="По левому краю"><i class="fa-solid fa-align-left"></i></button>
                        <button type="button" data-rich-command="justifyCenter" title="По центру" aria-label="По центру"><i class="fa-solid fa-align-center"></i></button>
                        <button type="button" data-rich-command="justifyRight" title="По правому краю" aria-label="По правому краю"><i class="fa-solid fa-align-right"></i></button>
                        <button type="button" data-rich-command="justifyFull" title="По ширине" aria-label="По ширине"><i class="fa-solid fa-align-justify"></i></button>
                        <button type="button" data-rich-command="insertUnorderedList" title="Маркированный список" aria-label="Маркированный список"><i class="fa-solid fa-list-ul"></i></button>
                        <button type="button" data-rich-command="insertOrderedList" title="Нумерованный список" aria-label="Нумерованный список"><i class="fa-solid fa-list-ol"></i></button>
                        <button type="button" data-rich-command="removeFormat" title="Очистить форматирование" aria-label="Очистить форматирование"><i class="fa-solid fa-eraser"></i></button>
                      </div>
                      <div class="fbl-vn-rich-editable" contenteditable="true" role="textbox" aria-label="Текст реплики или наррации" aria-multiline="true" spellcheck="true" data-text-block-rich data-placeholder="Текст реплики или наррации">{{{richText}}}</div>
                    </div>
                    <div class="text-block-bottom">
                      <div class="form-group path-field voice-field no-label">
                        <input type="text" name="{{inputName}}" data-text-block-voice value="{{voice}}" placeholder="ogg/mp3/wav, пусто = без озвучки" />
                        <button type="button" data-action="pickAsset" data-field="{{inputName}}" data-picker-type="audio" title="Выбрать файл озвучки" aria-label="Выбрать файл озвучки"><i class="fa-solid fa-folder-open"></i></button>
                      </div>
                      <div class="text-block-actions">
                        <button type="button" data-action="moveTextBlock" data-direction="up" data-text-block-id="{{id}}" title="Выше" aria-label="Выше"><i class="fa-solid fa-arrow-up"></i></button>
                        <button type="button" data-action="moveTextBlock" data-direction="down" data-text-block-id="{{id}}" title="Ниже" aria-label="Ниже"><i class="fa-solid fa-arrow-down"></i></button>
                        <button type="button" data-action="duplicateTextBlock" data-text-block-id="{{id}}" title="Дублировать" aria-label="Дублировать"><i class="fa-regular fa-copy"></i></button>
                        <button type="button" data-action="deleteTextBlock" data-text-block-id="{{id}}" title="Удалить" aria-label="Удалить"><i class="fa-solid fa-xmark"></i></button>
                      </div>
                    </div>
                  </div>
                {{/each}}
              </div>
            </section>
  
            <section class="fbl-vn-audio-mixer">
              <header class="fbl-vn-audio-mixer-header">
                <div>
                  <h4>Аудио кадра</h4>
                  <p>Канал позволяет держать несколько звуков одновременно. Запуск в том же канале заменяет только этот канал.</p>
                </div>
              </header>

              <datalist id="fbl-vn-music-channels">
                {{#each musicChannelOptions}}<option value="{{value}}"></option>{{/each}}
              </datalist>
              <datalist id="fbl-vn-sfx-channels">
                {{#each sfxChannelOptions}}<option value="{{value}}"></option>{{/each}}
              </datalist>

              <section class="fbl-vn-audio-group">
                <header class="fbl-vn-audio-group-header">
                  <div>
                    <strong>Музыка</strong>
                    <span>Зацикливание включено по умолчанию.</span>
                  </div>
                  <div class="fbl-vn-audio-group-actions">
                    <button type="button" data-action="addAudioCue" data-audio-kind="music"><i class="fa-solid fa-plus"></i> Действие</button>
                    <button type="button" data-action="addAudioCue" data-audio-kind="music" data-audio-action="stop-all"><i class="fa-solid fa-stop"></i> Стоп всё</button>
                  </div>
                </header>
                {{#if selectedMusicCues}}
                  <div class="fbl-vn-audio-cue-list">
                    {{#each selectedMusicCues}}
                      <div class="fbl-vn-audio-cue" data-audio-cue-row data-audio-kind="music" data-audio-cue-id="{{id}}">
                        <span class="fbl-vn-audio-cue-index">{{index}}</span>
                        <div class="form-group">
                          <label>Действие</label>
                          <select data-audio-action>
                            {{#each actionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                          </select>
                        </div>
                        <div class="form-group">
                          <label>Канал</label>
                          <input type="text" data-audio-channel list="fbl-vn-music-channels" value="{{channel}}" placeholder="music-1" />
                        </div>
                        <div class="form-group path-field fbl-vn-audio-source">
                          <label>Файл</label>
                          <input type="text" name="{{inputName}}" data-audio-src value="{{src}}" placeholder="ogg/mp3/wav" />
                          <button type="button" data-action="pickAsset" data-field="{{inputName}}" data-picker-type="audio" data-audio-picker title="Выбрать файл" aria-label="Выбрать файл"><i class="fa-solid fa-folder-open"></i></button>
                        </div>
                        <label class="fbl-vn-audio-loop" title="Повторять звук по кругу">
                          <span>Цикл</span>
                          <input type="checkbox" data-audio-loop {{#if loop}}checked{{/if}} />
                        </label>
                        <div class="fbl-vn-audio-cue-actions">
                          <button type="button" data-action="moveAudioCue" data-audio-kind="music" data-audio-cue-id="{{id}}" data-direction="up" title="Выше" aria-label="Выше"><i class="fa-solid fa-arrow-up"></i></button>
                          <button type="button" data-action="moveAudioCue" data-audio-kind="music" data-audio-cue-id="{{id}}" data-direction="down" title="Ниже" aria-label="Ниже"><i class="fa-solid fa-arrow-down"></i></button>
                          <button type="button" data-action="duplicateAudioCue" data-audio-kind="music" data-audio-cue-id="{{id}}" title="Дублировать" aria-label="Дублировать"><i class="fa-regular fa-copy"></i></button>
                          <button type="button" data-action="deleteAudioCue" data-audio-kind="music" data-audio-cue-id="{{id}}" title="Удалить" aria-label="Удалить"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                      </div>
                    {{/each}}
                  </div>
                {{else}}
                  <p class="fbl-vn-audio-empty">Музыка в этом кадре не меняется.</p>
                {{/if}}
              </section>

              <section class="fbl-vn-audio-group">
                <header class="fbl-vn-audio-group-header">
                  <div>
                    <strong>SFX</strong>
                    <span>Одноразовые эффекты можно оставлять без цикла; длинные или фоновые эффекты можно зациклить и остановить позже по каналу.</span>
                  </div>
                  <div class="fbl-vn-audio-group-actions">
                    <button type="button" data-action="addAudioCue" data-audio-kind="sfx"><i class="fa-solid fa-plus"></i> Действие</button>
                    <button type="button" data-action="addAudioCue" data-audio-kind="sfx" data-audio-action="stop-all"><i class="fa-solid fa-stop"></i> Стоп всё</button>
                  </div>
                </header>
                {{#if selectedSfxCues}}
                  <div class="fbl-vn-audio-cue-list">
                    {{#each selectedSfxCues}}
                      <div class="fbl-vn-audio-cue" data-audio-cue-row data-audio-kind="sfx" data-audio-cue-id="{{id}}">
                        <span class="fbl-vn-audio-cue-index">{{index}}</span>
                        <div class="form-group">
                          <label>Действие</label>
                          <select data-audio-action>
                            {{#each actionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                          </select>
                        </div>
                        <div class="form-group">
                          <label>Канал</label>
                          <input type="text" data-audio-channel list="fbl-vn-sfx-channels" value="{{channel}}" placeholder="sfx-1" />
                        </div>
                        <div class="form-group path-field fbl-vn-audio-source">
                          <label>Файл</label>
                          <input type="text" name="{{inputName}}" data-audio-src value="{{src}}" placeholder="ogg/mp3/wav" />
                          <button type="button" data-action="pickAsset" data-field="{{inputName}}" data-picker-type="audio" data-audio-picker title="Выбрать файл" aria-label="Выбрать файл"><i class="fa-solid fa-folder-open"></i></button>
                        </div>
                        <label class="fbl-vn-audio-loop" title="Повторять звук по кругу">
                          <span>Цикл</span>
                          <input type="checkbox" data-audio-loop {{#if loop}}checked{{/if}} />
                        </label>
                        <div class="fbl-vn-audio-cue-actions">
                          <button type="button" data-action="moveAudioCue" data-audio-kind="sfx" data-audio-cue-id="{{id}}" data-direction="up" title="Выше" aria-label="Выше"><i class="fa-solid fa-arrow-up"></i></button>
                          <button type="button" data-action="moveAudioCue" data-audio-kind="sfx" data-audio-cue-id="{{id}}" data-direction="down" title="Ниже" aria-label="Ниже"><i class="fa-solid fa-arrow-down"></i></button>
                          <button type="button" data-action="duplicateAudioCue" data-audio-kind="sfx" data-audio-cue-id="{{id}}" title="Дублировать" aria-label="Дублировать"><i class="fa-regular fa-copy"></i></button>
                          <button type="button" data-action="deleteAudioCue" data-audio-kind="sfx" data-audio-cue-id="{{id}}" title="Удалить" aria-label="Удалить"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                      </div>
                    {{/each}}
                  </div>
                {{else}}
                  <p class="fbl-vn-audio-empty">SFX в этом кадре не запускаются и не останавливаются.</p>
                {{/if}}
              </section>
            </section>
  
            <section class="fbl-vn-frame-counter-effect">
              <header>
                <div>
                  <h4>Изменение счётчика</h4>
                  <span>Применяется один раз при входе в этот кадр.</span>
                </div>
              </header>
              <div class="fbl-vn-frame-counter-effect-fields">
                <div class="form-group">
                  <label>Счётчик</label>
                  <select name="frame.effectCounterId">
                    {{#each frameEffectCounterOptions}}
                      <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if invalid}}class="is-invalid-option"{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </div>
                <div class="form-group">
                  <label>Операция</label>
                  <select name="frame.effectOperation">
                    {{#each frameEffectOperationOptions}}
                      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </div>
                <div class="form-group">
                  <label>На</label>
                  <input type="number" min="0" step="1" name="frame.effectValue" value="{{selectedFrame.effectValue}}" />
                </div>
              </div>
            </section>

            <div class="fbl-vn-field-row row-next-final">
              <section class="fbl-vn-frame-route {{#if nextRoutingEnabled}}is-counter-routing{{/if}}" data-next-routing-shell>
                <header class="fbl-vn-frame-route-header">
                  <span class="fbl-vn-frame-route-title">Следующий кадр</span>
                  <label class="fbl-vn-route-toggle" title="Выбрать следующий кадр по результату проверки счётчика.">
                    <input type="checkbox" name="frame.nextRouting.enabled" {{#if nextRoutingEnabled}}checked{{/if}} />
                    <span class="fbl-vn-route-toggle-box"><i class="fa-solid fa-code-branch"></i></span>
                    <span>Проверка счётчика</span>
                  </label>
                </header>

                <div class="fbl-vn-frame-route-next" data-frame-next-fields {{#if nextRoutingEnabled}}hidden{{/if}}>
                  <div class="fbl-vn-target-picker {{#if frameNextInvalid}}is-invalid{{/if}}">
                    <input type="hidden" name="frame.next" value="{{selectedFrame.next}}" />
                    <input type="search" data-frame-target-search data-target-field="frame.next" data-empty-label="Следующий кадр по списку" list="fbl-vn-frame-targets" value="{{frameNextTarget}}" placeholder="Найти кадр" />
                    <button type="button" data-action="clearFrameTarget" data-field="frame.next" data-empty-label="Следующий кадр по списку" title="Следующий кадр по списку" aria-label="Следующий кадр по списку"><i class="fa-solid fa-link-slash"></i></button>
                  </div>
                </div>

                <div class="fbl-vn-frame-next-routing" data-next-routing-fields {{#unless nextRoutingEnabled}}hidden{{/unless}}>
                  <div class="fbl-vn-route-condition-row">
                    <div class="form-group slim">
                      <label>Счётчик</label>
                      <select name="frame.nextRouting.counterId">
                        {{#each nextRoutingCounterOptions}}
                          <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if invalid}}class="is-invalid-option"{{/if}}>{{label}}</option>
                        {{/each}}
                      </select>
                    </div>
                    <div class="form-group slim">
                      <label>Сравнение</label>
                      <select name="frame.nextRouting.operator">
                        {{#each nextRoutingOperatorOptions}}
                          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                      </select>
                    </div>
                    <div class="form-group slim fbl-vn-route-value">
                      <label>Значение</label>
                      <input type="number" step="1" name="frame.nextRouting.value" value="{{nextRouting.value}}" />
                    </div>
                  </div>

                  <div class="fbl-vn-route-outcome-row">
                    <label><i class="fa-solid fa-check"></i> Если да</label>
                    <div class="fbl-vn-target-picker {{#if nextRoutingTrueInvalid}}is-invalid{{/if}}">
                      <input type="hidden" name="frame.nextRouting.trueFrameId" value="{{nextRouting.trueFrameId}}" />
                      <input type="search" data-frame-target-search data-target-field="frame.nextRouting.trueFrameId" data-empty-label="Следующий кадр по списку" list="fbl-vn-frame-targets" value="{{nextRoutingTrueTarget}}" placeholder="Найти кадр" />
                      <button type="button" data-action="clearFrameTarget" data-field="frame.nextRouting.trueFrameId" data-empty-label="Следующий кадр по списку" title="Следующий кадр по списку" aria-label="Следующий кадр по списку"><i class="fa-solid fa-link-slash"></i></button>
                    </div>
                  </div>

                  <div class="fbl-vn-route-outcome-row">
                    <label><i class="fa-solid fa-xmark"></i> Если нет</label>
                    <div class="fbl-vn-target-picker {{#if nextRoutingFalseInvalid}}is-invalid{{/if}}">
                      <input type="hidden" name="frame.nextRouting.falseFrameId" value="{{nextRouting.falseFrameId}}" />
                      <input type="search" data-frame-target-search data-target-field="frame.nextRouting.falseFrameId" data-empty-label="Следующий кадр по списку" list="fbl-vn-frame-targets" value="{{nextRoutingFalseTarget}}" placeholder="Найти кадр" />
                      <button type="button" data-action="clearFrameTarget" data-field="frame.nextRouting.falseFrameId" data-empty-label="Следующий кадр по списку" title="Следующий кадр по списку" aria-label="Следующий кадр по списку"><i class="fa-solid fa-link-slash"></i></button>
                    </div>
                  </div>
                </div>
              </section>

              <label class="form-group final-toggle-field" title="Финальный кадр. После него катсцена завершится." aria-label="Финальный кадр">
                <span>Финал</span>
                <input type="checkbox" name="frame.isFinal" {{#if selectedFrame.isFinal}}checked{{/if}} />
                <span class="icon-toggle"><i class="fa-solid fa-flag-checkered"></i></span>
              </label>
            </div>
  
            {{#if isChoice}}
              <section class="fbl-vn-choices">
                <header>
                  <h4>Варианты выбора</h4>
                  <button type="button" data-action="addChoice"><i class="fa-solid fa-plus"></i> Добавить</button>
                </header>
                <div class="fbl-vn-editor-choice-list">
                  {{#each selectedChoices}}
                    <div class="fbl-vn-choice-row {{#if hasError}}has-error{{/if}} {{#if hasWarning}}has-warning{{/if}}" data-choice-row data-choice-id="{{id}}">
                      <div class="choice-index">{{index}})</div>
                      <div class="choice-main-line">
                        <div class="form-group choice-text">
                          <label>Текст выбора</label>
                          <input type="text" data-choice-text value="{{text}}" placeholder="Текст выбора" class="{{#if hasError}}is-invalid{{/if}}" />
                        </div>
                        <div class="form-group choice-target">
                          <label>Переход</label>
                          <div class="fbl-vn-target-picker {{#if brokenTarget}}is-invalid{{/if}}">
                            <input type="hidden" data-choice-next value="{{next}}" />
                            <input type="search" data-frame-target-search data-empty-label="Следующий кадр по списку" list="fbl-vn-frame-targets" value="{{targetLabel}}" placeholder="Найти кадр" />
                            <button type="button" data-action="clearFrameTarget" data-empty-label="Следующий кадр по списку" title="Следующий кадр по списку" aria-label="Следующий кадр по списку"><i class="fa-solid fa-link-slash"></i></button>
                          </div>
                        </div>
                        <div class="choice-actions">
                          <button type="button" data-action="moveChoice" data-direction="up" data-choice-id="{{id}}" title="Выше" aria-label="Выше"><i class="fa-solid fa-arrow-up"></i></button>
                          <button type="button" data-action="moveChoice" data-direction="down" data-choice-id="{{id}}" title="Ниже" aria-label="Ниже"><i class="fa-solid fa-arrow-down"></i></button>
                          <button type="button" data-action="duplicateChoice" data-choice-id="{{id}}" title="Дублировать" aria-label="Дублировать"><i class="fa-regular fa-copy"></i></button>
                          <button type="button" data-action="deleteChoice" data-choice-id="{{id}}" title="Удалить" aria-label="Удалить"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                      </div>
                      <div class="choice-logic-line">
                        <div class="choice-logic-block choice-condition-block">
                          <span class="choice-logic-title">Доступность</span>
                          <div class="form-group choice-condition-counter">
                            <label>Счётчик</label>
                            <select data-choice-condition-counter class="{{#if hasWarning}}is-warning{{/if}}">
                              {{#each conditionCounterOptions}}
                                <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if invalid}}class="is-invalid-option"{{/if}}>{{label}}</option>
                              {{/each}}
                            </select>
                          </div>
                          <div class="form-group choice-condition-op">
                            <label>Сравнение</label>
                            <select data-choice-condition-operator>
                              {{#each conditionOperatorOptions}}
                                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                              {{/each}}
                            </select>
                          </div>
                          <div class="form-group choice-condition-value">
                            <label>Значение</label>
                            <input type="number" step="1" data-choice-condition-value value="{{conditionValue}}" />
                          </div>
                        </div>
                        <div class="choice-logic-block choice-effect-block">
                          <span class="choice-logic-title">Изменение счётчика</span>
                          <div class="form-group choice-effect-counter">
                            <label>Счётчик</label>
                            <select data-choice-effect-counter class="{{#if hasWarning}}is-warning{{/if}}">
                              {{#each effectCounterOptions}}
                                <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if invalid}}class="is-invalid-option"{{/if}}>{{label}}</option>
                              {{/each}}
                            </select>
                          </div>
                          <div class="form-group choice-effect-op">
                            <label>Операция</label>
                            <select data-choice-effect-operation>
                              {{#each effectOperationOptions}}
                                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                              {{/each}}
                            </select>
                          </div>
                          <div class="form-group choice-effect-value">
                            <label>На</label>
                            <input type="number" min="0" step="1" data-choice-effect-value value="{{effectValue}}" />
                          </div>
                        </div>
                      </div>
                    </div>
                  {{/each}}
                </div>
              </section>
            {{/if}}
          {{else}}
            <p class="empty">Выберите кадр.</p>
          {{/if}}
  {{/if}}
</section>
