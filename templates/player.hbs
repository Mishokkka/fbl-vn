<section class="fbl-vn-player {{#if loading}}is-loading{{/if}} {{#if started}}is-started{{/if}} {{#if reducedMotion}}is-reduced-motion{{/if}} {{#if contentHidden}}is-content-hidden{{/if}}" data-mode="{{mode}}">
  {{#if loading}}
    <div class="fbl-vn-loader">
      <div class="mark">VN</div>
      <h2>{{scene.title}}</h2>
      <p>Предзагрузка ассетов: <span data-preload-label>{{preloadDone}} / {{preloadTotal}}</span></p>
      <progress data-preload-progress max="{{preloadTotal}}" value="{{preloadDone}}"></progress>
    </div>
  {{else}}
    {{#unless started}}
      <div class="fbl-vn-loader">
        <div class="mark">VN</div>
        <h2>{{scene.title}}</h2>
        <p>Готово. Ожидаю старт.</p>
      </div>
    {{/unless}}
  {{/if}}

  {{#if started}}
    <div class="fbl-vn-bg {{transitionClass}}" data-background-src="{{backgroundSrc}}"></div>
    <div class="fbl-vn-vignette"></div>

    {{#if hasPortrait}}
      <img class="fbl-vn-portrait {{portraitClass}} {{transitionClass}}" src="{{portraitSrc}}" alt="{{portraitAlt}}" />
    {{/if}}

    <div class="fbl-vn-dialogue {{#if isCenteredText}}is-centered-text{{/if}}" data-vn-advance-area>
      {{#unless isCenteredText}}
        <button type="button" class="fbl-vn-hide-content" data-action="hideContent" title="Скрыть текст и персонажей" aria-label="Скрыть текст и персонажей" aria-expanded="true"><i class="fa-solid fa-eye-slash"></i></button>
      {{/unless}}
      {{#if hasSpeaker}}
        <div class="fbl-vn-speaker">{{frame.speaker}}</div>
      {{/if}}
      <div class="fbl-vn-text" data-vn-text></div>

      {{#if showChoices}}
        <div class="fbl-vn-player-choice-list">
          {{#each choices}}
            <button type="button" class="{{#if selected}}is-selected{{/if}} {{#if unavailable}}is-unavailable{{/if}}" data-action="choose" data-choice-id="{{id}}" {{#unless ../canAdvance}}disabled{{/unless}} {{#if ../localHasVoted}}disabled{{/if}} {{#unless available}}disabled{{/unless}}>
              <span class="fbl-vn-choice-text">{{text}}</span>
              {{#if ../isVoteMode}}<span class="fbl-vn-vote-count">{{voteCount}} / {{../voteTotal}}</span>{{/if}}
            </button>
          {{/each}}
        </div>
      {{else}}
        {{#if canAdvance}}
          <button type="button" class="fbl-vn-next {{#if localHasVoted}}is-voted{{/if}}" data-action="next" {{#if localHasVoted}}disabled{{/if}}>
            {{#if isVoteMode}}
              <span data-vote-action-label>{{#if localHasVoted}}Ждём остальных{{else}}Продолжить{{/if}}</span>
              <span class="fbl-vn-vote-count">{{voteCount}} / {{voteTotal}}</span>
            {{else}}
              Продолжить
            {{/if}}
          </button>
        {{else}}
          <div class="fbl-vn-wait">Ожидание ведущего</div>
        {{/if}}
      {{/if}}
    </div>

    {{#unless isCenteredText}}
      <button type="button" class="fbl-vn-show-content" data-action="showContent" title="Показать текст и персонажей" aria-label="Показать текст и персонажей" aria-hidden="true"><i class="fa-solid fa-eye"></i></button>
    {{/unless}}

    <div class="fbl-vn-volume-widget">
      {{#if volumePanelOpen}}
        <div class="fbl-vn-volume-panel">
          {{#each volumeLevels}}
            <label class="fbl-vn-volume-row">
              <span class="fbl-vn-volume-label">{{label}}</span>
              <input type="range" min="0" max="1" step="0.05" value="{{value}}" data-vn-volume="{{key}}" />
              <span class="fbl-vn-volume-value">{{percent}}%</span>
            </label>
          {{/each}}
        </div>
      {{/if}}
      <button type="button" class="fbl-vn-volume-toggle" data-action="toggleVolumePanel" title="Громкость" aria-label="Громкость" aria-expanded="{{#if volumePanelOpen}}true{{else}}false{{/if}}">
        <i class="fa-solid fa-volume-high"></i>
      </button>
    </div>

    {{#if canClose}}
      <button type="button" class="fbl-vn-close" data-action="closeCutscene" title="Закрыть" aria-label="Закрыть"><i class="fa-solid fa-xmark"></i></button>
    {{/if}}
  {{/if}}
</section>
